{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start:dev": "turbo run start:dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "biome:lint": "bun biome lint apps && bun biome lint packages",
    "bump": "bunx npm-check-updates -u --deep -p bun && bun i && bun update"
  },
  "dependencies": {
    "lodash": "4.18.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.5",
    "@types/uuid": "11.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-deprecation": "3.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "knip": "6.43.0",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": "22.10.0"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "@nestjs/core"
  ]
}
